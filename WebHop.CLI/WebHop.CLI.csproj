<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>webhop</AssemblyName>
    <RootNamespace>WebHop.CLI</RootNamespace>

    <!-- dotnet pack makes it installable with: dotnet tool install -g webhop -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>webhop</ToolCommandName>
    <PackageId>webhop</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebHop.Origin\WebHop.Origin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebHop.Tests" />
  </ItemGroup>

</Project>
