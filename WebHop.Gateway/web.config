<?xml version="1.0" encoding="utf-8"?>
<!--
  Only used when the gateway runs behind IIS (Azure App Service on Windows).
  The gateway serves no files from disk and forwards everything to the tunneled
  apps, so these rules protect nothing here.
  The publish step adds the ASP.NET Core module settings.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering allowDoubleEscaping="true">
          <fileExtensions allowUnlisted="true">
            <clear />
          </fileExtensions>
          <hiddenSegments>
            <clear />
          </hiddenSegments>
          <requestLimits maxAllowedContentLength="4294967295" maxUrl="8192" maxQueryString="8192" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
